{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@map/*": ["map/*"]
    },
    "types": ["vitest/globals", "vitest/jsdom"]
  },
  "include": ["src/**/*"]
}
